# Copy to .env next to compose.yml on the server and fill in.
# Every key in the repository's root .env.example works here too; the ones below are what a deployment needs.

# Public hostname. Its DNS A record must point at this server before the first `up` (Caddy gets the HTTPS certificate).
DOMAIN=slides.example.com

# Database password. Use hex (openssl rand -hex 24): it goes into a URL, so avoid @ : / ? #
POSTGRES_PASSWORD=

# Image tag: latest (main), a release such as 1.2.0, or sha-abc1234.
SLEID_TAG=latest

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 48
COLLAB_TOKEN_SECRET=
# openssl rand -hex 24
COLLAB_INTERNAL_SECRET=
# openssl rand -base64 32. Keep a copy: without it, saved AI provider keys cannot be read.
LLM_SECRET_KEY=

# Google sign-in. Authorized redirect URI: https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated admin emails (they manage the workspace AI providers).
ADMIN_EMAILS=

# Optional: server-wide AI provider, picker, web search. See the root .env.example for every option.
SLEID_LLM_KIND=
SLEID_LLM_ENDPOINT=
SLEID_LLM_API_KEY=
SLEID_LLM_MODEL=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
SEARXNG_URL=
BRAVE_API_KEY=
TAVILY_API_KEY=
