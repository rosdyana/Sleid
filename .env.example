# Copy to .env (git-ignored) and fill in. Dev: `pnpm dev`, migrations: `pnpm db:migrate`.

# Local compose Postgres (see compose.yml; host port 5433)
DATABASE_URL=postgres://sleid:sleid@127.0.0.1:5433/sleid

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-random-bytes
# Public origin of the web app. Google redirect URI is ${BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud OAuth client (Web application). See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test-only: set to 1 to also enable email+password sign-in for Playwright.
# Refused at startup when NODE_ENV=production. Leave empty otherwise.
SLEID_TEST_AUTH=
