# Copy to .env (git-ignored) and fill in. Dev: `pnpm dev`, migrations: `pnpm db:migrate`.

# Local compose Postgres (see compose.yml; host port 5433)
DATABASE_URL=postgres://sleid:sleid@127.0.0.1:5433/sleid

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-random-bytes
# Public origin of the web app. Google redirect URI is ${BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud OAuth client (Web application). See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test-only: set to 1 to also enable email+password sign-in for Playwright.
# Refused at startup when NODE_ENV=production. Leave empty otherwise.
SLEID_TEST_AUTH=

# --- Live co-editing (M2) ---

# Signs the short-lived (5 minute) collab tokens that apps/web issues and apps/collab checks.
# At least 32 characters. Must be the same value for both apps. openssl rand -base64 48
COLLAB_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Shared secret for the collab internal API (POST /internal/decks/:id/ops, and friends).
# At least 16 characters. Only apps/web and trusted local tools may know it. openssl rand -hex 24
COLLAB_INTERNAL_SECRET=replace-with-at-least-16-random-characters

# Collab service (apps/collab). Defaults shown.
COLLAB_PORT=3001
# Bound to localhost unless you set 0.0.0.0 (for example in a container).
COLLAB_HOST=127.0.0.1
# The internal API runs on its own listener, also bound to localhost.
COLLAB_INTERNAL_PORT=3002
COLLAB_INTERNAL_HOST=127.0.0.1

# Read by the browser: the WebSocket URL of the collab service.
VITE_COLLAB_URL=ws://localhost:3001

# Read by apps/web on the server: where to reach the internal API.
# Only needed when it is not http://127.0.0.1:${COLLAB_INTERNAL_PORT}.
# COLLAB_INTERNAL_URL=http://127.0.0.1:3002

# --- Exports, assets and publishing (M3) ---

# Storage for uploaded images and finished exports. `local` (disk) is the only driver. `s3` is a stub that refuses to start.
STORAGE_DRIVER=local
# Relative paths resolve against the repository root, so the web app and the worker find the same files.
ASSET_DIR=data/assets
EXPORT_DIR=data/exports

# Chrome for PDF, PNG/JPG and the Mermaid pictures in PPTX. Empty: Playwright's bundled Chromium,
# installed with `pnpm exec playwright install chromium`. Example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=

# Export jobs the worker runs at once (1 to 32).
EXPORT_CONCURRENCY=2
# Scratch folder for export work. Empty: the OS temp directory.
EXPORT_TMP_DIR=

# --- AI assistant (M4) ---

# 32 random bytes, base64. Encrypts provider API keys at rest (AES-256-GCM). Keep it safe: without it, stored keys cannot be read.
# openssl rand -base64 32
LLM_SECRET_KEY=

# Comma-separated emails of administrators. They can add and edit workspace providers, which everyone on the instance can use.
ADMIN_EMAILS=

# Optional server-wide default provider, used when no provider is saved in the database. Leave SLEID_LLM_KIND empty to skip it.
# SLEID_LLM_KIND: foundry-claude | azure-openai | openai-compatible
SLEID_LLM_KIND=
SLEID_LLM_NAME=Server default
# foundry-claude: resource name or https://<resource>.services.ai.azure.com/anthropic/
# azure-openai: https://<resource>.openai.azure.com
# openai-compatible: the base URL including /v1, for example http://127.0.0.1:11434/v1
SLEID_LLM_ENDPOINT=
# foundry-claude and azure-openai need a key. Local servers usually do not.
SLEID_LLM_API_KEY=
# The model name for local servers, the deployment name for Foundry and Azure (for example claude-opus-5-5).
SLEID_LLM_MODEL=
# azure-openai only. Default 2024-10-21.
SLEID_LLM_API_VERSION=
# auto | json_schema | tools | prompt. auto tries the schema first, then falls back. prompt is JSON-only prompting for small local models.
SLEID_LLM_STRUCTURED=auto
# true when the model accepts pictures (used for alt text). Claude on Foundry always accepts them.
SLEID_LLM_SUPPORTS_IMAGES=false

# Assistant requests per user in a sliding window. Failed requests count. Defaults: 30 requests per 600 seconds.
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_SECONDS=600

# Set to 1 only on a single-user setup. It lets a user's own AI provider use loopback and private addresses (a local
# Ollama or LM Studio). Off by default: a user provider cannot then reach 127.0.0.1, 10.x, 192.168.x and similar.
# Workspace providers (added by an administrator) and the server default may use private addresses either way.
# Cloud metadata and link-local addresses are refused always. Empty or any other value leaves it off.
LLM_USER_ALLOW_PRIVATE_URLS=

# --- MCP server and access tokens (M5) ---

# Calls to /mcp per personal access token per minute. Counted in memory, per web process.
MCP_RATE_LIMIT_PER_MINUTE=120
# Largest request body accepted on POST /mcp, in bytes.
MCP_MAX_BODY_BYTES=1048576
