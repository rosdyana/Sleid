# Copy to .env (git-ignored) and fill in. Dev: `pnpm dev`, migrations: `pnpm db:migrate`.

# Local compose Postgres (see compose.yml; host port 5433)
DATABASE_URL=postgres://sleid:sleid@127.0.0.1:5433/sleid

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-random-bytes
# Public origin of the web app. Google redirect URI is ${BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud OAuth client (Web application). See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test-only: set to 1 to also enable email+password sign-in for Playwright.
# Refused at startup when NODE_ENV=production. Leave empty otherwise.
SLEID_TEST_AUTH=

# --- Live co-editing (M2) ---

# Signs the short-lived (5 minute) collab tokens that apps/web issues and apps/collab checks.
# At least 32 characters. Must be the same value for both apps. openssl rand -base64 48
COLLAB_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Shared secret for the collab internal API (POST /internal/decks/:id/ops, and friends).
# At least 16 characters. Only apps/web and trusted local tools may know it. openssl rand -hex 24
COLLAB_INTERNAL_SECRET=replace-with-at-least-16-random-characters

# Collab service (apps/collab). Defaults shown.
COLLAB_PORT=3001
# Bound to localhost unless you set 0.0.0.0 (for example in a container).
COLLAB_HOST=127.0.0.1
# The internal API runs on its own listener, also bound to localhost.
COLLAB_INTERNAL_PORT=3002
COLLAB_INTERNAL_HOST=127.0.0.1

# Read by the browser: the WebSocket URL of the collab service.
VITE_COLLAB_URL=ws://localhost:3001

# Read by apps/web on the server: where to reach the internal API.
# Only needed when it is not http://127.0.0.1:${COLLAB_INTERNAL_PORT}.
# COLLAB_INTERNAL_URL=http://127.0.0.1:3002
